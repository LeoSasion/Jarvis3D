<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Isolated build intermediates must not cause project-local obj files to enter source globs. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../Jarvis.Host/Infrastructure/HostDataPaths.cs" Link="HostDataPaths.cs" />
    <Compile Include="../Jarvis.Host/Services/GraphVisualSettingsStore.cs" Link="GraphVisualSettingsStore.cs" />
    <Compile Include="../Jarvis.Host/Services/AtomicJsonSettingsStore.cs" Link="AtomicJsonSettingsStore.cs" />
    <Compile Include="../Jarvis.Host/Services/ConfigurationPreferencesStore.cs" Link="ConfigurationPreferencesStore.cs" />
    <Compile Include="../Jarvis.Host/Services/ConfigurationSnapshotStore.cs" Link="ConfigurationSnapshotStore.cs" />
    <Compile Include="../Jarvis.Host/Services/SettingsRestoreTransaction.cs" Link="SettingsRestoreTransaction.cs" />
    <Compile Include="../Jarvis.Host/Agents/AgentConversationStore.cs" Link="AgentConversationStore.cs" />
    <Compile Include="../Jarvis.Host/Services/ObsidianGraphService.cs" Link="ObsidianGraphService.cs" />
    <Compile Include="../Jarvis.Host/Services/ObsidianKnowledgeService.cs" Link="ObsidianKnowledgeService.cs" />
    <Compile Include="../Jarvis.Host/Services/ObsidianVaultWatcher.cs" Link="ObsidianVaultWatcher.cs" />
  </ItemGroup>
</Project>
